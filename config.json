{
  "shared": {
    "vscode_theme": "Light 2026",
    "vs_code_extensions": [
      "GitHub.copilot",
      "GitHub.copilot-chat",
      "GitHub.codespaces",
      "github.vscode-github-actions",
      "GitHub.vscode-pull-request-github",
      "GitHub.remotehub",
      "GitHub.vscode-codeql"
    ],
    "gh_cli_extensions": [
      "advanced-security/gh-sbom",
      "github/gh-actions-importer",
      "github/gh-classroom",
      "github/gh-codeql",
      "github/gh-gei",
      "github/gh-models",
      "github/gh-skyline",
      "github-samples/gh-game"
    ],
    "pwa_sites": [],
    "vlc_settings": "osd=0 # Hide filename display\nloop=1 # Enable loop by default\nvideo-title-show=0 # Hide filename display",
    "mcp_servers": [
      {
        "name": "microsoft-learn",
        "type": "http",
        "url": "https://learn.microsoft.com/api/mcp"
      },
      {
        "name": "astro-docs",
        "type": "http",
        "url": "https://mcp.docs.astro.build/mcp"
      },
      {
        "name": "svelte-docs",
        "type": "http",
        "url": "https://mcp.svelte.dev/mcp"
      }
    ],
    "gh_auth_scopes": [
      "codespace",
      "delete_repo",
      "project",
      "workflow"
    ],
    "repos_to_clone": [
      "octobooth-demos/repo-setup-scripts",
      "octobooth-demos/tailspin-toys",
      "octobooth-demos/security-octo-supply"
    ]
  },
  "mac": {
    "packages": {
      "casks": [
        "visual-studio-code",
        "visual-studio-code@insiders",
        "vlc",
        "copilot-cli",
        "github-copilot-app",
        "google-chrome",
        "github",
        "iterm2",
        "font-sf-mono",
        "font-monaspace",
        "font-mona-sans"
      ],
      "formulas": [
        "gh",
        "python@3.14",
        "nvm",
        "defaultbrowser",
        "dockutil"
      ]
    },
    "editors": [
      {
        "name": "VS Code",
        "binary": "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code",
        "command": "code",
        "settings_dir": "Code"
      },
      {
        "name": "VS Code Insiders",
        "binary": "/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin/code",
        "command": "code-insiders",
        "settings_dir": "Code - Insiders"
      }
    ],
    "iterm2": {
      "light": {
        "color_preset": "GitHub Light Default",
        "color_scheme_file": "iterm2/github-light-default.itermcolors"
      },
      "dark": {
        "color_preset": "GitHub Dark Default",
        "color_scheme_file": "iterm2/github-dark-default.itermcolors"
      },
      "font": "MonaspaceNeonFrozen-Regular 14",
      "theme": "minimal",
      "ligatures": true,
      "thin_strokes": "never"
    },
    "post_install_launch": [],
    "dock_apps": [
      "Google Chrome",
      "GitHub Copilot",
      "Visual Studio Code",
      "Visual Studio Code - Insiders",
      "iTerm",
      "VLC"
    ],
    "monaspace_frozen_version": "1.400"
  },
  "windows": {
    "packages": [
      "Microsoft.PowerShell",
      "Microsoft.VisualStudioCode",
      "Microsoft.VisualStudioCode.Insiders",
      "Microsoft.WindowsTerminal",
      "Git.Git",
      "GitHub.cli",
      "OpenJS.NodeJS.LTS",
      "Python.Python.3.14",
      "VideoLAN.VLC",
      "GitHub.Copilot",
      "GitHub.CopilotApp",
      "GitHub.GitHubDesktop"
    ],
    "editors": [
      {
        "name": "VS Code",
        "command": "code",
        "settings_dir": "Code"
      },
      {
        "name": "VS Code Insiders",
        "command": "code-insiders",
        "settings_dir": "Code - Insiders"
      }
    ],
    "taskbar_pins": [
      {
        "name": "Visual Studio Code",
        "app_id": "Microsoft.VisualStudioCode"
      },
      {
        "name": "Visual Studio Code - Insiders",
        "app_id": "Microsoft.VisualStudioCodeInsiders"
      },
      {
        "name": "GitHub Copilot",
        "app_id": "com.github.githubapp"
      },
      {
        "name": "Terminal",
        "app_id": "Microsoft.WindowsTerminal_8wekyb3d8bbwe!App"
      },
      {
        "name": "VLC media player",
        "app_id": "{6D809377-6AF0-444B-8957-A3773F02200E}\\VideoLAN\\VLC\\vlc.exe"
      }
    ],
    "post_install_launch": []
  }
}
