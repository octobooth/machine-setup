{
  "shared": {
    "vscode_theme": "Default Dark+",
    "vs_code_extensions": [
      "GitHub.copilot",
      "GitHub.copilot-chat",
      "GitHub.codespaces",
      "github.vscode-github-actions",
      "GitHub.vscode-pull-request-github",
      "GitHub.remotehub",
      "GitHub.vscode-codeql"
    ],
    "gh_cli_extensions": [
      "advanced-security/gh-sbom",
      "github/gh-actions-importer",
      "github/gh-classroom",
      "github/gh-codeql",
      "github/gh-gei",
      "github/gh-models",
      "github/gh-skyline",
      "github-samples/gh-game"
    ],
    "pwa_sites": [],
    "demo_sites": [
      "https://github.com"
    ],
    "vlc_settings": "osd=0 # Hide filename display\nloop=1 # Enable loop by default\nvideo-title-show=0 # Hide filename display",
    "mcp_servers": [
      {
        "name": "playwright",
        "type": "local",
        "command": "playwright-mcp",
        "args": []
      },
      {
        "name": "microsoft-learn",
        "type": "http",
        "url": "https://learn.microsoft.com/api/mcp"
      },
      {
        "name": "astro-docs",
        "type": "http",
        "url": "https://mcp.docs.astro.build/mcp"
      },
      {
        "name": "svelte-docs",
        "type": "http",
        "url": "https://mcp.svelte.dev/mcp"
      },
      {
        "name": "aspire",
        "type": "local",
        "command": "aspire",
        "args": [
          "agent",
          "mcp"
        ]
      },
      {
        "name": "azure-devops",
        "type": "local",
        "command": "mcp-server-azuredevops",
        "args": [
          "<YOUR-ADO-ORG>"
        ]
      },
      {
        "name": "azure",
        "type": "local",
        "command": "azmcp",
        "args": [
          "server",
          "start"
        ]
      }
    ],
    "npm_global_packages": [
      "@playwright/mcp",
      "@azure/mcp",
      "@azure-devops/mcp"
    ],
    "placeholders": [
      "<YOUR-ADO-ORG>"
    ],
    "repos_to_clone": [
      "octobooth/setup-scripts",
      "octobooth/tailspin-toys",
      "octobooth/security-octo-supply"
    ]
  },
  "mac": {
    "packages": {
      "casks": [
        "visual-studio-code",
        "visual-studio-code@insiders",
        "vlc",
        "copilot-cli",
        "google-chrome",
        "github",
        "github-copilot-app",
        "# JetBrains IDEs: prefix any entry with '# ' to disable it",
        "intellij-idea",
        "pycharm",
        "rider",
        "webstorm",
        "# goland",
        "# clion",
        "# phpstorm",
        "# rubymine",
        "# datagrip",
        "# rustrover"
      ],
      "formulas": [
        "git",
        "gh",
        "python@3.14",
        "nvm",
        "node",
        "neovim"
      ]
    },
    "editors": [
      {
        "name": "VS Code",
        "binary": "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code",
        "command": "code",
        "settings_dir": "Code"
      },
      {
        "name": "VS Code Insiders",
        "binary": "/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin/code-insiders",
        "command": "code-insiders",
        "settings_dir": "Code - Insiders"
      }
    ],
    "post_install_launch": []
  },
  "windows": {
    "packages": [
      "# To disable any package below, prefix its id with '# '. Lines starting with # are skipped.",
      "Git.Git",
      "Microsoft.VisualStudioCode",
      "Microsoft.VisualStudioCode.Insiders",
      "Microsoft.WindowsTerminal",
      "GitHub.cli",
      "VideoLAN.VLC",
      "GitHub.Copilot",
      "Google.Chrome",
      "GitHub.GitHubDesktop",
      "OpenJS.NodeJS.LTS",
      "# Neovim + JetBrains IDEs (prefix any id with '# ' to disable it)",
      "Neovim.Neovim",
      "JetBrains.IntelliJIDEA.Ultimate",
      "JetBrains.PyCharm.Professional",
      "JetBrains.Rider",
      "JetBrains.WebStorm",
      "# JetBrains.GoLand",
      "# JetBrains.CLion",
      "# JetBrains.PhpStorm",
      "# JetBrains.RubyMine",
      "# JetBrains.DataGrip",
      "# JetBrains.RustRover"
    ],
    "visual_studio": {
      "edition": "Enterprise",
      "bootstrapper_url": "https://aka.ms/vs/stable/vs_enterprise.exe",
      "install_path": "C:\\Program Files\\Microsoft Visual Studio\\2026\\Enterprise",
      "workloads": [
        "Microsoft.VisualStudio.Workload.NetWeb",
        "Microsoft.VisualStudio.Workload.Azure",
        "Microsoft.VisualStudio.Workload.ManagedDesktop"
      ],
      "include_recommended": true
    },
    "copilot_app": {
      "url_x64": "https://github.com/github/app/releases/latest/download/GitHub-Copilot-windows-x64-setup.exe",
      "url_arm64": "https://github.com/github/app/releases/latest/download/GitHub-Copilot-windows-arm64-setup.exe"
    },
    "editors": [
      {
        "name": "VS Code",
        "command": "code",
        "settings_dir": "Code"
      },
      {
        "name": "VS Code Insiders",
        "command": "code-insiders",
        "settings_dir": "Code - Insiders"
      }
    ],
    "post_install_launch": []
  }
}
